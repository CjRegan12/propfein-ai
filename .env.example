# Copy this file to .env and fill it in. .env is git-ignored and must never be committed.
#
# Read-only Postgres login for the eval harness (role: propfein_ai_ro).
# Get the host from Supabase > Connect > Session pooler, then swap the user
# to propfein_ai_ro.<project-ref> and put in the password you generated.
DATABASE_URL=postgresql://propfein_ai_ro.<project-ref>:<password>@<pooler-host>:5432/postgres
